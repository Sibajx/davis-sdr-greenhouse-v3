# Opcional: permite que el usuario de la sesión activa acceda al dongle
# RTL-SDR sin sudo.
#
# El ID 0bda:2838 es el genérico de los dongles RTL2832U más comunes
# (RTL-SDR Blog, NooElec, etc.). Si tu dongle usa otro chipset, revisa
# el ID real con `lsusb` y ajusta aquí.
#
# TAG+="uaccess" es el mecanismo nativo de systemd/Fedora: le da acceso
# al usuario de la sesión activa sin necesitar un grupo (plugdev no
# existe en Fedora por default) ni cerrar sesión para que aplique.
#
# Instalación:
#   sudo cp 99-rtlsdr.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# En Debian/Ubuntu, si prefieres el mecanismo clásico de grupo en vez de
# uaccess: cambia TAG+="uaccess" por GROUP="plugdev" y agrega tu usuario
# al grupo (sudo usermod -aG plugdev $USER), luego cierra sesión.

SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", MODE="0666", TAG+="uaccess"
